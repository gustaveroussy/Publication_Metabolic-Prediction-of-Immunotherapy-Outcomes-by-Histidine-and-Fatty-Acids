BootStrap: docker
From: ubuntu:24.04

#build image
#sudo singularity build R_SuissaD_2026.simg R_SuissaD_2026.def &> R_SuissaD_2026.log
#using image
#singularity shell -B local_folder:/WORKDIR/container_folder R_SuissaD_2026.simg
#singularity exec -B local_folder:/WORKDIR/container_folder R_SuissaD_2026.simg Rscript script.R

%environment
    export PATH=/opt/tools/bin:$PATH
    export RETICULATE_MINICONDA_ENABLED=FALSE
    LANG=en_US.UTF-8
    LC_ALL=en_US.UTF-8
    LC_TIME=en_US.UTF-8
    LC_MONETARY=en_US.UTF-8
    LC_PAPER=en_US.UTF-8
    LC_MEASUREMENT=en_US.UTF-8
    CFLAGS=-I/usr/include/hdf5/serial
    CXXFLAGS=-I/usr/include/hdf5/serial
    LDFLAGS=-L/usr/lib/x86_64-linux-gnu/hdf5/serial

%post
    echo "Ubuntu version ######################"
    cat /etc/lsb-release
    apt-get -y update && apt-get -y upgrade
    
    ln -fs /usr/share/zoneinfo/Europe/Paris /etc/localtime
    apt-get install -y tzdata
    dpkg-reconfigure --frontend noninteractive tzdata
    
    apt-get install -y wget build-essential g++ libcurl4-openssl-dev libssl-dev libxml2-dev libgsl-dev libgit2-dev libpython3-dev libgmp3-dev tzdata libfontconfig1-dev  libharfbuzz-dev libfribidi-dev libharfbuzz-dev libfribidi-dev libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev libcairo2-dev libxt-dev libgeos-dev libhdf5-dev libhdf5-serial-dev libmagick++-dev libz-dev cmake pkg-config build-essential libuv1-dev
    apt-get install -y dirmngr gnupg apt-transport-https ca-certificates software-properties-common
    apt-get -y update && apt-get -y upgrade
    apt-key adv --keyserver hkp://keyserver.ubuntu.com:80 --recv-keys E298A3A825C0D65DFD57CBB651716619E084DAB9
    add-apt-repository 'deb https://cloud.r-project.org/bin/linux/ubuntu noble-cran40/'
    apt-get -y update && apt-get -y upgrade
    apt-get install -y r-base r-base-dev #apt-cache policy r-base r-base-dev pour connaître les versions

    echo "R version ######################"
    R --version

    echo "Install R packages ######################"

    R -e 'install.packages("DynForest")'
    R -e 'library("DynForest")'
    R -e 'install.packages("timeROC")'
    R -e 'library("timeROC")'
    R -e 'install.packages("ggplot2")'
    R -e 'library("ggplot2")'
    R -e 'install.packages("ggalluvial")'
    R -e 'library("ggalluvial")'
    R -e 'install.packages("dplyr")'
    R -e 'library("dplyr")'
    R -e 'install.packages("tidyverse")'
    R -e 'library("tidyverse")'
    R -e 'install.packages("pec")'
    R -e 'library("pec")'
    R -e 'install.packages("prodlim")'
    R -e 'library("prodlim")'
    R -e 'install.packages("foreach")'
    R -e 'library("foreach")'
    R -e 'install.packages("doParallel")'
    R -e 'library("doParallel")'
    R -e 'install.packages("patchwork")'
    R -e 'library("patchwork")'
    R -e 'install.packages("readxl")'
    R -e 'library("readxl")'
    R -e 'install.packages("nftbart")'
    R -e 'library("nftbart")'

%labels
    Author Marine AGLAVE
